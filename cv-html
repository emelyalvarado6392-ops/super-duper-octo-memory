<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>CV - Emely Dayana Alvarado Hernández</title>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: "Segoe UI", Arial, sans-serif;
            background: #fdf4f8;
            color: #444;
            line-height: 1.6;
        }

        .cv {
            max-width: 1000px;
            margin: 30px auto;
            background: white;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 8px 30px rgba(150, 80, 120, 0.15);
        }

        /* ENCABEZADO */
        header {
            background: linear-gradient(135deg, #d98bb2, #b879a6);
            color: white;
            padding: 45px;
            text-align: center;
        }

        header h1 {
            font-size: 36px;
            margin-bottom: 8px;
            letter-spacing: 1px;
        }

        header h2 {
            font-size: 20px;
            font-weight: 400;
            margin-bottom: 15px;
        }

        .correo {
            font-size: 15px;
        }

        /* CONTENIDO */
        .contenido {
            display: grid;
            grid-template-columns: 1fr 2fr;
        }

        .izquierda {
            background: #fff1f7;
            padding: 35px;
        }

        .derecha {
            padding: 35px;
        }

        section {
            margin-bottom: 32px;
        }

        h3 {
            color: #a55787;
            font-size: 21px;
            margin-bottom: 15px;
            border-bottom: 2px solid #e7b4cd;
            padding-bottom: 7px;
        }

        p {
            margin-bottom: 12px;
        }

        ul {
            padding-left: 20px;
        }

        li {
            margin-bottom: 8px;
        }

        .habilidad {
            margin-bottom: 18px;
        }

        .habilidad strong {
            color: #9b4f7d;
            display: block;
            margin-bottom: 3px;
        }

        .puesto {
            color: #9b4f7d;
            font-size: 19px;
            font-weight: bold;
        }

        .empresa {
            font-weight: bold;
            color: #555;
            margin-bottom: 10px;
        }

        .semestre {
            display: inline-block;
            background: #d98bb2;
            color: white;
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 13px;
            margin: 5px 0 12px;
        }

        .contacto {
            background: white;
            padding: 18px;
            border-radius: 15px;
            margin-top: 15px;
        }

        .contacto p {
            margin-bottom: 5px;
        }

        footer {
            text-align: center;
            padding: 20px;
            background: #b879a6;
            color: white;
            font-size: 14px;
        }

        /* RESPONSIVE PARA CELULAR */
        @media (max-width: 700px) {

            .cv {
                margin: 10px;
                border-radius: 15px;
            }

            header {
                padding: 30px 20px;
            }

            header h1 {
                font-size: 27px;
            }

            header h2 {
                font-size: 17px;
            }

            .contenido {
                grid-template-columns: 1fr;
            }

            .izquierda,
            .derecha {
                padding: 25px;
            }
        }

        /* IMPRESIÓN */
        @media print {
            body {
                background: white;
            }

            .cv {
                margin: 0;
                box-shadow: none;
            }
        }
    </style>
</head>

